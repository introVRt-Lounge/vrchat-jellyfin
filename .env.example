# VRChat Jellyfin - Environment Variables
# Copy this file to .env and configure your values

# =============================================================================
# REQUIRED VARIABLES (must be set)
# =============================================================================

# Jellyfin Server Configuration
JELLYFIN_HOST=https://your-jellyfin-server.com
JELLYFIN_USERNAME=your-jellyfin-username
JELLYFIN_PASSWORD=your-jellyfin-password

# =============================================================================
# OPTIONAL VARIABLES (have defaults, can be overridden)
# =============================================================================

# Audio/Video Quality Settings
AUDIO_BITRATE=192000              # Audio bitrate in bits per second (default: 192000)
VIDEO_BITRATE=5000000             # Video bitrate in bits per second (default: 5000000)
MAX_AUDIO_CHANNELS=2              # Maximum audio channels (default: 2)
MAX_HEIGHT=1080                   # Maximum video height in pixels (default: 1080)
MAX_WIDTH=1920                    # Maximum video width in pixels (default: 1920)

# =============================================================================
# RECOMMENDED SETTINGS FOR DIFFERENT USE CASES
# =============================================================================

# For high-quality streaming (good bandwidth):
# AUDIO_BITRATE=320000
# VIDEO_BITRATE=8000000
# MAX_HEIGHT=1440
# MAX_WIDTH=2560

# For low-bandwidth scenarios:
# AUDIO_BITRATE=128000
# VIDEO_BITRATE=2000000
# MAX_HEIGHT=720
# MAX_WIDTH=1280

# For mobile/VR optimization:
# AUDIO_BITRATE=128000
# VIDEO_BITRATE=3000000
# MAX_HEIGHT=720
# MAX_WIDTH=1280
# MAX_AUDIO_CHANNELS=2
