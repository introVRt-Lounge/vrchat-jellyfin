JELLYFIN_HOST=https://your-jellyfin-server.com
JELLYFIN_USERNAME=your-jellyfin-username
JELLYFIN_PASSWORD=your-jellyfin-password
# Unique per running instance. Jellyfin invalidates the prior token when the same
# user+DeviceId authenticates again — prod and dev must not share this value.
# JELLYFIN_DEVICE_ID=jellyfin-vrchat

# Optional (have defaults)
AUDIO_BITRATE=192000
VIDEO_BITRATE=5000000
MAX_AUDIO_CHANNELS=2
MAX_HEIGHT=1080
MAX_WIDTH=1920
WEBSERVER_PORT=4000

# Capability stream URLs (see docs/capability-urls.md)
PROXY_STORE_PATH=./data/proxies.json
PROXY_TTL_MS=86400000
# Max selectable lifetime (default 30d). Mint UI offers presets up to this.
PROXY_TTL_MAX_MS=2592000000
# Optional: only these Discord role snowflakes may mint longer than PROXY_TTL_MS
# STREAM_URL_EXTENDED_ROLE_IDS=
JELLYFIN_AUTH_RETRIES=30
JELLYFIN_AUTH_RETRY_MS=5000

# Public UI (GET /config) — no secrets. Omit Discord IDs to hide the Widgetbot embed.
# UI_THEME=default|lounge
UI_THEME=lounge
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=

# Empty-search movie requests (Radarr + Discord channel webhook). All three required to enable.
# RADARR_URL=http://radarr:7878/radarr
# RADARR_API_KEY=
# RADARR_QUALITY_PROFILE_ID=4
# RADARR_ROOT_FOLDER=/data/movies
# DISCORD_REQUEST_READY_WEBHOOK_URL=https://discord.com/api/webhooks/...
# MOVIE_REQUEST_STORE_PATH=/data/movie-requests.json
# MOVIE_REQUEST_POLL_MS=60000
# Cloudflare Access Discord OIDC must include claim `id` (Discord snowflake) for @mentions.

# OCI Object Storage HLS fan-out (dev / spike only — leave OFF on prod).
# Requires a Customer Secret Key (S3 API) + ObjectRead bucket. See docs/handoffs.
# OCI_HLS_PUBLISH=0
# OCI_S3_ACCESS_KEY=
# OCI_S3_SECRET_KEY=
# OCI_S3_NAMESPACE=
# OCI_S3_REGION=us-ashburn-1
# OCI_S3_BUCKET=owncast
# OCI_S3_ENDPOINT=https://<namespace>.compat.objectstorage.us-ashburn-1.oraclecloud.com
# OCI_PUBLIC_BASE=https://objectstorage.us-ashburn-1.oraclecloud.com/n/<namespace>/b/<bucket>/o
# OCI_HLS_KEY_PREFIX=vrchat-fanout
# Cap bake length (seconds). 0 = full title. Default 120 for safe spike mints.
# OCI_HLS_MAX_SECONDS=120
# OCI_HLS_TIME=6
# OCI_HLS_WORK_DIR=/tmp/vrchat-oci-hls

